# Airport RMS Backend - Environment variables
# Copy to .env and adjust values

# SQLite (по умолчанию): файл будет создан рядом с backend/
DATABASE_URL=sqlite:///./airport_rms.db

# PostgreSQL (опционально, драйвер psycopg v3). Для psycopg2 используйте postgresql://
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/airport_rms

# Optional
DEBUG=false
API_V1_PREFIX=/api/v1
